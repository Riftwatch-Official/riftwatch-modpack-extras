#!/usr/bin/env python3
import hashlib
import io
import pathlib
import re
import sys
import urllib.request
import zipfile

repository = pathlib.Path(__file__).resolve().parent.parent
source_version = "3.3.3"
source_name = f"DistantHorizons-{source_version}-1.21.1-fabric-neoforge.jar"
source_url = f"https://cdn.modrinth.com/data/uCdwusMi/versions/9w34y8ai/{source_name}"
source_sha512 = "d14b32d3fd143a06514d6ad388eee11e9d657c84e1a937aaf8d033b1137fb43ef8b05cff1011a994cc42f3106823c51234f8bc18d72bb05bc317a20ea83c50ed"
patched_version = f"{source_version}-patched"
patched_name = "Distant Horizons (patched)"
output = repository / "output" / f"DistantHorizons-{patched_version}-1.21.1-fabric-neoforge.jar"

gl_state_class = "com/seibel/distanthorizons/common/render/openGl/glObject/GLState.class"
gl_get_polygon_mode = re.compile(rb"\xb2..\x11\x0b\x40\xb9..\x02\x00(\xb5..)", re.DOTALL)
gl_fill_constant = b"\x11\x1b\x02" + b"\x00" * 8


def fail(message):
    print(f"distant-horizons/build: {message}", file=sys.stderr)
    sys.exit(1)


def source_jar():
    request = urllib.request.Request(source_url, headers={"User-Agent": "riftwatch-modpack-extras/1.0"})
    with urllib.request.urlopen(request) as response:
        data = response.read()
    if hashlib.sha512(data).hexdigest() != source_sha512:
        fail(f"checksum mismatch for {source_name}")
    return data


def replace_once(name, data, old, new):
    count = data.count(old)
    if count != 1:
        fail(f"expected one match in {name}, found {count}")
    return data.replace(old, new)


def patch_gl_state(data):
    matches = list(gl_get_polygon_mode.finditer(data))
    if len(matches) != 1:
        fail(f"expected one GL_POLYGON_MODE read in {gl_state_class}, found {len(matches)}")
    match = matches[0]
    replacement = gl_fill_constant + match.group(1)
    if len(replacement) != len(match.group(0)):
        fail(f"replacement in {gl_state_class} changes the code length")
    return data[: match.start()] + replacement + data[match.end():]


def patch_neoforge_manifest(data):
    data = replace_once("neoforge.mods.toml", data, f'version = "{source_version}"'.encode(), f'version = "{patched_version}"'.encode())
    return replace_once("neoforge.mods.toml", data, b'displayName = "Distant Horizons"', f'displayName = "{patched_name}"'.encode())


def patch_fabric_manifest(data):
    data = replace_once("fabric.mod.json", data, f'"version": "{source_version}"'.encode(), f'"version": "{patched_version}"'.encode())
    return replace_once("fabric.mod.json", data, b'"name": "Distant Horizons"', f'"name": "{patched_name}"'.encode())


patches = {
    gl_state_class: patch_gl_state,
    "META-INF/neoforge.mods.toml": patch_neoforge_manifest,
    "fabric.mod.json": patch_fabric_manifest,
}


def main():
    patched = io.BytesIO()
    done = set()
    with zipfile.ZipFile(io.BytesIO(source_jar())) as source, zipfile.ZipFile(patched, "w") as target:
        for info in source.infolist():
            data = source.read(info)
            if info.filename in patches:
                data = patches[info.filename](data)
                done.add(info.filename)
            target.writestr(info, data, compress_type=info.compress_type)
    missing = set(patches) - done
    if missing:
        fail(f"entries not found: {', '.join(sorted(missing))}")
    data = patched.getvalue()
    output.parent.mkdir(exist_ok=True)
    output.write_bytes(data)
    print(f"wrote output/{output.name} ({len(data)} bytes)")
    print(f"sha512 {hashlib.sha512(data).hexdigest()}")


main()
