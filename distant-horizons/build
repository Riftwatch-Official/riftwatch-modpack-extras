#!/usr/bin/env python3
import hashlib
import io
import pathlib
import sys
import urllib.request
import zipfile

repository = pathlib.Path(__file__).resolve().parent.parent
source_name = "DistantHorizons-3.2.0-b-1.21.1-fabric-neoforge.jar"
source_url = f"https://cdn.modrinth.com/data/uCdwusMi/versions/ZpKb4kZp/{source_name}"
source_sha512 = "d4199f92f992fbd2c75a3b0e4e81c8a98bee889013f7347f2149ffa62c86748bde22135e9b2c82a10875db94fa576571c661c5ee16d2f567bd8a93d6f255fd22"
source_version = "3.2.0-b"
patched_version = "3.2.0-b-patched"
patched_name = "Distant Horizons (patched)"
output = repository / "output" / f"DistantHorizons-{patched_version}-1.21.1-fabric-neoforge.jar"

gl_get_polygon_mode = bytes.fromhex("110b40b80042b500ae")
gl_fill_constant = bytes.fromhex("111b02000000b500ae")

replacements = {
    "com/seibel/distanthorizons/common/render/openGl/glObject/GLState.class": [
        (gl_get_polygon_mode, gl_fill_constant),
    ],
    "META-INF/neoforge.mods.toml": [
        (f'version = "{source_version}"'.encode(), f'version = "{patched_version}"'.encode()),
        (b'displayName = "Distant Horizons"', f'displayName = "{patched_name}"'.encode()),
    ],
    "fabric.mod.json": [
        (f'"version": "{source_version}"'.encode(), f'"version": "{patched_version}"'.encode()),
        (b'"name": "Distant Horizons"', f'"name": "{patched_name}"'.encode()),
    ],
}


def fail(message):
    print(f"distant-horizons/build: {message}", file=sys.stderr)
    sys.exit(1)


def source_jar():
    request = urllib.request.Request(source_url, headers={"User-Agent": "riftwatch-modpack-extras/1.0"})
    with urllib.request.urlopen(request) as response:
        data = response.read()
    if hashlib.sha512(data).hexdigest() != source_sha512:
        fail(f"checksum mismatch for {source_name}")
    return data


def patch(name, data):
    for old, new in replacements[name]:
        if len(old) != len(new) and name.endswith(".class"):
            fail(f"replacement in {name} changes the code length")
        count = data.count(old)
        if count != 1:
            fail(f"expected one match in {name}, found {count}")
        data = data.replace(old, new)
    return data


def main():
    patched = io.BytesIO()
    done = set()
    with zipfile.ZipFile(io.BytesIO(source_jar())) as source, zipfile.ZipFile(patched, "w") as target:
        for info in source.infolist():
            data = source.read(info)
            if info.filename in replacements:
                data = patch(info.filename, data)
                done.add(info.filename)
            target.writestr(info, data, compress_type=info.compress_type)
    missing = set(replacements) - done
    if missing:
        fail(f"entries not found: {', '.join(sorted(missing))}")
    data = patched.getvalue()
    output.parent.mkdir(exist_ok=True)
    output.write_bytes(data)
    print(f"wrote output/{output.name} ({len(data)} bytes)")
    print(f"sha512 {hashlib.sha512(data).hexdigest()}")


main()
